# Sistema de testimonios (Supabase).
# Endpoint de la función que recibe y devuelve los testimonios.
# Es la misma URL para enviar (desde el navegador) y para leer (desde el navegador).
PUBLIC_RESENAS_ENDPOINT=https://TU_PROYECTO.supabase.co/functions/v1/resenas

# Token del sitio que autoriza la función de reseñas.
PUBLIC_SITE_TOKEN=TU_SITE_TOKEN
