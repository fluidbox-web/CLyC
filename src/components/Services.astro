---
const categorias = [
  {
    key: 'familiar',
    etiqueta: 'Materia familiar',
    descripcion: 'Asesoría sensible y estratégica para resolver conflictos familiares con acompañamiento claro en cada etapa.',
    cifra: '08 servicios',
    acento: 'from-cyan-500 to-sky-600',
    borde: 'border-cyan-500/25',
    fondo: 'bg-cyan-500/8',
    servicios: [
      'Divorcios',
      'Guarda y custodia',
      'Régimen de convivencia',
      'Pensión alimenticia',
      'Reconocimiento de paternidad',
      'Pérdida de patria potestad',
      'Juicio sucesorio testamentario e intestamentario',
      'Consignación de pensión',
    ],
  },
  {
    key: 'civil',
    etiqueta: 'Materia civil',
    descripcion: 'Litigio y asesoría civil para proteger patrimonio, contratos y derechos reales con visión preventiva y de fondo.',
    cifra: '07 servicios',
    acento: 'from-cyan-500 to-sky-600',
    borde: 'border-cyan-500/25',
    fondo: 'bg-cyan-500/8',
    servicios: [
      'Juicios de nulidad',
      'Juicios reivindicatorios',
      'Prescripción positiva',
      'Cumplimiento de contratos',
      'Acción proforma',
      'Rescisión',
      'Daños',
    ],
  },
  {
    key: 'civil-oral',
    etiqueta: 'Materia civil oral',
    descripcion: 'Procesos orales diseñados para responder con rapidez y precisión en asuntos de garantía, posesión y jurisdicción voluntaria.',
    cifra: '03 servicios',
    acento: 'from-cyan-500 to-sky-600',
    borde: 'border-cyan-500/25',
    fondo: 'bg-cyan-500/8',
    servicios: [
      'Juicio hipotecario',
      'Juicio de desahucio',
      'Jurisdicciones voluntarias',
    ],
  },
  {
    key: 'mercantil',
    etiqueta: 'Materia mercantil',
    descripcion: 'Cobranza, contratos y títulos de crédito con enfoque en recuperación efectiva y control del riesgo comercial.',
    cifra: '05 servicios',
    acento: 'from-cyan-500 to-sky-600',
    borde: 'border-cyan-500/25',
    fondo: 'bg-cyan-500/8',
    servicios: [
      'Cumplimiento de contrato',
      'Rescisión de contrato',
      'Pago',
      'Vencimiento anticipado de contrato',
      'Ejecución de pagarés, títulos de crédito y otros',
    ],
  },
  {
    key: 'amparos',
    etiqueta: 'Amparos',
    descripcion: 'Defensa constitucional para proteger derechos frente a actos de autoridad, en vía indirecta o directa.',
    cifra: '02 servicios',
    acento: 'from-cyan-500 to-sky-600',
    borde: 'border-cyan-500/25',
    fondo: 'bg-cyan-500/8',
    servicios: [
      'Amparo indirecto',
      'Amparo directo',
    ],
  },
  {
    key: 'migracion',
    etiqueta: 'Migración',
    descripcion: 'Gestión migratoria ordenada para resolver trámites, renovación documental y visados sin fricción.',
    cifra: '05 servicios',
    acento: 'from-cyan-500 to-sky-600',
    borde: 'border-cyan-500/25',
    fondo: 'bg-cyan-500/8',
    servicios: [
      'Obtención de constancia de empleador',
      'Actualización de constancia de empleador',
      'Visas por oferta de empleo o vínculo familiar',
      'Canje de visa',
      'Renovación de tarjeta migratoria',
    ],
  },
  {
    key: 'contratos',
    etiqueta: 'Contratos',
    descripcion: 'Redacción y revisión contractual para blindar operaciones patrimoniales, laborales y de prestación de servicios.',
    cifra: '08 servicios',
    acento: 'from-cyan-500 to-sky-600',
    borde: 'border-cyan-500/25',
    fondo: 'bg-cyan-500/8',
    servicios: [
      'Compraventa',
      'Cesión de derechos',
      'Arrendamiento',
