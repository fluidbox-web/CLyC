---
import logoImage from '../assets/logo/logo2.png';

const navLinks = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#nosotras', label: 'Nosotras' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#testimonios', label: 'Testimonios' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-500">
  
  <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent opacity-0 transition-opacity duration-500" id="navbar-accent"></div>

  <div class="bg-white/70 backdrop-blur-xl border-b border-slate-200/30 transition-all duration-500
      dark:bg-slate-950/80 dark:border-slate-800/50"
       id="navbar-inner">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
      <div class="grid grid-cols-[auto_1fr_auto] items-center h-16 md:h-[4.5rem] relative">

        <a href="#inicio" class="flex-shrink-0 group flex items-center gap-3.5">
          <div class="relative">
            <div class="absolute inset-0 bg-cyan-400/20 rounded-full blur-lg scale-75 group-hover:scale-100 transition-transform duration-500"></div>
            <img
              src={logoImage.src}
              alt="CL&C DE LA RIVIERA"
              class="relative h-11 md:h-12 w-auto"
            />
          </div>
          <div class="flex flex-col leading-none">
            <span class="font-serif text-base md:text-lg font-bold tracking-[0.15em] text-slate-800 dark:text-slate-100 transition-colors duration-300"
            >
              CL&C
            </span>
            <span class="text-[0.6rem] md:text-[0.65rem] tracking-[0.25em] uppercase text-cyan-400 font-semibold"
            >
              De La Riviera
            </span>
          </div>
        </a>

        <nav
          id="nav-center"
          class="hidden md:flex items-center justify-center gap-1 absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 max-w-[calc(100%-26rem)]">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="relative px-4 py-2 text-sm font-medium tracking-wider uppercase text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100 transition-colors duration-300 group">
              {link.label}
              <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-cyan-400 rounded-full transition-all duration-300 group-hover:w-3/4"></span>
            </a>
          ))}
        </nav>

        <div class="flex justify-end">
          <a href="#contacto" class="hidden md:inline-flex btn-primary !rounded-full !px-6 !py-2.5 text-xs tracking-wider uppercase">
            Agenda una cita
          </a>
        </div>

        <div class="flex items-center gap-2 md:hidden">
          <button
            id="menu-toggle"
            class="relative w-10 h-10 flex flex-col items-center justify-center gap-1.5 focus:outline-none group"
            aria-label="Abrir menu">
            <span class="block w-5 h-[2px] bg-slate-600 dark:bg-slate-500 group-hover:bg-cyan-400 transition-all duration-300 rounded-full origin-center" id="bar-1"></span>
            <span class="block w-5 h-[2px] bg-slate-600 dark:bg-slate-500 group-hover:bg-cyan-400 transition-all duration-300 rounded-full" id="bar-2"></span>
            <span class="block w-5 h-[2px] bg-slate-600 dark:bg-slate-500 group-hover:bg-cyan-400 transition-all duration-300 rounded-full origin-center" id="bar-3"></span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden overflow-hidden max-h-0 transition-all duration-500 ease-in-out">
    <div class="bg-white/95 backdrop-blur-xl border-b border-slate-200/30 dark:bg-slate-950/95 dark:border-slate-800/50">
      <nav class="flex flex-col px-6 pb-8 pt-2 space-y-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="relative text-slate-600 hover:text-cyan-400 dark:text-slate-400 dark:hover:text-cyan-300 transition-colors duration-300 text-lg font-medium py-3 before:absolute before:left-0 before:bottom-0 before:w-0 before:h-[2px] before:bg-cyan-400 before:rounded-full before:transition-all before:duration-300 hover:before:w-12">
            {link.label}
          </a>
        ))}
        <a href="#contacto" class="btn-primary !rounded-full text-center mt-4">
          Agenda una cita
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar-1');
  const bar2 = document.getElementById('bar-2');
  const bar3 = document.getElementById('bar-3');
  let isOpen = false;

  menuToggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    if (isOpen) {
      mobileMenu!.style.maxHeight = mobileMenu!.scrollHeight + 'px';
      bar1!.style.transform = 'rotate(45deg) translate(4px, 5px)';
      bar2!.style.opacity = '0';
      bar3!.style.transform = 'rotate(-45deg) translate(4px, -5px)';
    } else {
      mobileMenu!.style.maxHeight = '0';
      bar1!.style.transform = '';
      bar2!.style.opacity = '';
      bar3!.style.transform = '';
    }
  });

  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      isOpen = false;
      mobileMenu!.style.maxHeight = '0';
      bar1!.style.transform = '';
      bar2!.style.opacity = '';
      bar3!.style.transform = '';
    });
  });

  const navbar = document.getElementById('navbar-inner');
  const accent = document.getElementById('navbar-accent');
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 10;
    if (scrolled) {
      navbar?.classList.add('shadow-lg', 'shadow-slate-200/50', 'dark:shadow-slate-900/80');
      accent?.classList.add('opacity-100');
    } else {
      navbar?.classList.remove('shadow-lg', 'shadow-slate-200/50', 'dark:shadow-slate-900/80');
      accent?.classList.remove('opacity-100');
    }
  });
</script>
