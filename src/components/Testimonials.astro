---
import TestimonialForm from './TestimonialForm.astro';

const endpoint = import.meta.env.PUBLIC_RESENAS_ENDPOINT;
const siteToken = import.meta.env.PUBLIC_SITE_TOKEN;
---

<section id="testimonios" data-endpoint={endpoint} data-token={siteToken} class="relative py-14 md:py-20 bg-slate-100 dark:bg-slate-950 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none opacity-[0.55] dark:opacity-[0.18]" style="background-image: radial-gradient(circle at 1px 1px, rgba(148, 163, 184, 0.15) 1px, transparent 0); background-size: 32px 32px;"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 h-96 w-96 rounded-full bg-cyan-400/6 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-cyan-400/20 bg-white/70 px-4 py-2 text-xs font-semibold uppercase tracking-[0.28em] text-cyan-700 shadow-sm backdrop-blur dark:border-slate-700/70 dark:bg-slate-950/70 dark:text-cyan-200 opacity-0 translate-y-8" id="testimonios-eyebrow">
        Testimonios
      </div>

      <h2 class="section-title mt-6 opacity-0 translate-y-8" id="testimonios-title">
        Lo que dicen nuestros clientes
      </h2>

      <p class="section-subtitle mt-5 opacity-0 translate-y-8" id="testimonios-subtitle">
        La confianza de quienes nos han acompañado es nuestra mejor carta de presentación.
      </p>
    </div>

    <div id="testimonios-resumen" class="mt-8 hidden justify-center opacity-0 translate-y-8">
      <div class="inline-flex items-center gap-4 rounded-2xl border border-slate-200/80 bg-white/90 px-6 py-3 shadow-sm backdrop-blur dark:border-slate-800/60 dark:bg-slate-950/80">
        <div class="flex items-center gap-1 text-amber-400" id="testimonios-estrellas"></div>
        <div class="text-sm text-slate-600 dark:text-slate-400">
          <span id="testimonios-promedio" class="font-bold text-slate-800 dark:text-slate-100"></span>
          <span id="testimonios-total"></span>
        </div>
      </div>
    </div>

    <div id="testimonios-loading" class="mt-14 text-center text-slate-500 dark:text-slate-400">
      Cargando testimonios…
    </div>

    <div class="mt-14 flex items-center gap-2 sm:gap-4">
      <button
        type="button"
        id="testimonios-prev"
        aria-label="Ver testimonios anteriores"
        class="hidden h-11 w-11 flex-shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white/90 text-slate-500 shadow-lg backdrop-blur transition-all duration-300 hover:border-cyan-400 hover:text-cyan-500 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:border-slate-200 disabled:hover:text-slate-500 dark:border-slate-700 dark:bg-slate-900/90 dark:text-slate-300 dark:hover:border-cyan-400 dark:hover:text-cyan-300 dark:disabled:hover:border-slate-700 dark:disabled:hover:text-slate-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div id="testimonios-grid" class="min-w-0 flex-1 grid gap-6 sm:grid-cols-2 lg:grid-cols-2"></div>

      <button
        type="button"
        id="testimonios-next"
        aria-label="Ver testimonios siguientes"
        class="hidden h-11 w-11 flex-shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white/90 text-slate-500 shadow-lg backdrop-blur transition-all duration-300 hover:border-cyan-400 hover:text-cyan-500 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:border-slate-200 disabled:hover:text-slate-500 dark:border-slate-700 dark:bg-slate-900/90 dark:text-slate-300 dark:hover:border-cyan-400 dark:hover:text-cyan-300 dark:disabled:hover:border-slate-700 dark:disabled:hover:text-slate-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

    <div id="testimonios-vacio" class="mt-14 hidden text-center">
      <p class="text-slate-500 dark:text-slate-400">Aún no hay testimonios públicos. Sé el primero en compartir tu experiencia.</p>
    </div>

    <div id="testimonios-error" class="mt-14 hidden text-center text-red-500 dark:text-red-400">
      No se pudieron cargar los testimonios. Inténtalo de nuevo más tarde.
    </div>

    <div class="mt-12 text-center opacity-0 translate-y-8" id="testimonios-cta">
      <button
        type="button"
        id="abrir-testimonio-modal"
        class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-600 hover:text-cyan-500 dark:text-cyan-400 dark:hover:text-cyan-300 transition-colors duration-300 group"
      >
        ¿Nos acompañaste? Comparte tu experiencia
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform duration-300">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>

  <dialog
    id="testimonio-detalle"
    class="z-50 m-auto w-[calc(100%-2rem)] max-w-xl rounded-2xl border border-slate-200 bg-white p-0 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-950"
  >
    <div class="max-h-[85vh] overflow-y-auto p-6 md:p-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p id="detalle-nombre" class="font-semibold text-slate-800 dark:text-slate-100"></p>
          <p id="detalle-tipo" class="text-xs font-medium uppercase tracking-wider text-cyan-600 dark:text-cyan-400"></p>
          <p id="detalle-fecha" class="mt-0.5 text-[10px] text-slate-400 dark:text-slate-500"></p>
        </div>
        <button
          type="button"
          id="cerrar-detalle"
          aria-label="Cerrar"
          class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-900 dark:hover:text-slate-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <div id="detalle-estrellas" class="mt-4 flex gap-0.5 text-amber-400"></div>
      <p id="detalle-comentario" class="mt-4 whitespace-pre-line text-base leading-relaxed italic text-slate-600 dark:text-slate-300"></p>
    </div>
  </dialog>

  <TestimonialForm />
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById('testimonios');
  const endpoint = section?.dataset.endpoint;
  const siteToken = section?.dataset.token;

  const detalleDialog = document.getElementById('testimonio-detalle');
  let testimoniosVisibles = [];

  // Se descargan por lotes de BATCH y se muestran de PER_PAGE en PER_PAGE.
  // Mientras el lote ya esté en memoria, navegar con las flechas NO vuelve a pedir al servidor.
  const PER_PAGE = 4;
  const BATCH = 12;
  let currentPage = 1;
  let totalPages = 1;
  let cargados = [];
  let total = Infinity;
  let promedio = 0;
  let lotesCargados = 0;
  let cargandoLote = false;

  function generarIniciales(nombre) {
    return nombre
      .split(' ')
      .filter((parte) => parte.length > 0)
      .map((parte) => parte[0].toUpperCase())
      .slice(0, 2)
      .join('');
  }

  function formatearFecha(fechaIso) {
    const fecha = new Date(fechaIso);
    return fecha.toLocaleDateString('es-MX', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }

  function renderEstrellas(calificacion) {
    return Array.from({ length: 5 }, (_, i) => {
      const fill = i < calificacion ? 'currentColor' : 'none';
      const stroke = i < calificacion ? 'none' : 'currentColor';
      return `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="${fill}" stroke="${stroke}" stroke-width="2" class="text-amber-400"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`;
    }).join('');
  }

  function escaparHtml(valor) {
    return String(valor ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderTarjeta(testimonio, index) {
    const iniciales = escaparHtml(generarIniciales(testimonio.autor_nombre || ''));
    const fecha = testimonio.created_at ? formatearFecha(testimonio.created_at) : '';
    const tipo = escaparHtml(testimonio.titulo || 'Cliente');
    const nombre = escaparHtml(testimonio.autor_nombre || '');
    const comentario = escaparHtml(testimonio.comentario || '');

    return `
      <div class="testimonial-card group relative rounded-[2rem] border border-slate-200/80 bg-white/90 p-6 md:p-8 shadow-[0_20px_50px_rgba(15,23,42,0.06)] backdrop-blur transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_24px_60px_rgba(15,23,42,0.1)] dark:border-slate-800/60 dark:bg-slate-950/80 opacity-0 translate-y-8" data-testimonial="${index}">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" class="text-cyan-400/30 mb-4">
          <path fill="currentColor" d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>

        <p class="text-slate-600 dark:text-slate-400 text-base leading-relaxed italic line-clamp-2" data-comentario>
          "${comentario}"
        </p>

        <span class="mt-2 hidden inline-flex items-center gap-1 text-xs font-semibold text-cyan-600 dark:text-cyan-400" data-ver-mas>
          Ver más
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </span>

        <div class="mt-6 flex items-center gap-4">
          <div class="w-12 h-12 flex-shrink-0 rounded-full bg-gradient-to-br from-cyan-400 to-sky-600 flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-cyan-500/15">
            ${iniciales}
          </div>
          <div class="min-w-0">
            <p class="font-semibold text-slate-800 dark:text-slate-100 line-clamp-1" data-nombre>${nombre}</p>
            <p class="text-xs font-medium uppercase tracking-wider text-cyan-600 dark:text-cyan-400 truncate">${tipo}</p>
            ${fecha ? `<p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5">${fecha}</p>` : ''}
          </div>
        </div>

        <div class="absolute top-6 right-6 flex gap-0.5">
          ${renderEstrellas(testimonio.calificacion)}
        </div>
      </div>
    `;
  }

  function animarTarjetas() {
    const cards = gsap.utils.toArray('.testimonial-card');
    gsap.to(cards, {
      opacity: 1,
      y: 0,
      duration: 0.4,
      stagger: 0.08,
      scrollTrigger: {
        trigger: '#testimonios',
        start: 'top 75%',
        toggleActions: 'play none none none',
      },
    });
  }

  function animarHeader() {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#testimonios',
        start: 'top 80%',
        toggleActions: 'play none none none',
      },
    });

    tl.to('#testimonios-eyebrow', { opacity: 1, y: 0, duration: 0.4 })
      .to('#testimonios-title', { opacity: 1, y: 0, duration: 0.5 }, '-=0.2')
      .to('#testimonios-subtitle', { opacity: 1, y: 0, duration: 0.4 }, '-=0.2');

    gsap.to('#testimonios-cta', {
      opacity: 1,
      y: 0,
      duration: 0.4,
      scrollTrigger: {
        trigger: '#testimonios',
        start: 'top 65%',
        toggleActions: 'play none none none',
      },
    });
  }

  function actualizarControles() {
    const prev = document.getElementById('testimonios-prev');
    const next = document.getElementById('testimonios-next');
    if (!prev || !next) return;

    const mostrar = totalPages > 1;
    [prev, next].forEach((btn) => {
      btn.classList.toggle('hidden', !mostrar);
      btn.classList.toggle('flex', mostrar);
    });

    prev.disabled = currentPage <= 1;
    next.disabled = currentPage >= totalPages;
  }

  // Descarga el siguiente lote (BATCH testimonios) y lo acumula en memoria.
  // Devuelve cuántos testimonios nuevos llegaron.
  async function cargarLote() {
    if (cargandoLote || !endpoint || !siteToken) return 0;

    cargandoLote = true;
    try {
      const paginaLote = lotesCargados + 1;
      const url = `${endpoint}?site_token=${encodeURIComponent(siteToken)}&page=${paginaLote}&limit=${BATCH}`;
      const response = await fetch(url);
      const result = await response.json().catch(() => ({}));

      if (!response.ok || !result.ok) {
        throw new Error(result.error || 'Error cargando testimonios');
      }

      const data = result.data || {};
      const nuevas = data.reseñas || [];

      cargados = cargados.concat(nuevas);
      lotesCargados += 1;

      if (typeof data.total === 'number') total = data.total;
      if (typeof data.promedio === 'number') promedio = data.promedio;
      // Si el servidor no informa el total y el lote vino incompleto, ya no hay más.
      if (nuevas.length < BATCH && !Number.isFinite(total)) total = cargados.length;

      return nuevas.length;
    } finally {
      cargandoLote = false;
    }
  }

  async function renderPagina() {
    const grid = document.getElementById('testimonios-grid');
    const loading = document.getElementById('testimonios-loading');
    const vacio = document.getElementById('testimonios-vacio');
    const error = document.getElementById('testimonios-error');
    const resumen = document.getElementById('testimonios-resumen');

    if (!endpoint || !siteToken) {
      loading?.classList.add('hidden');
      error.textContent = 'Error de configuración: faltan las variables de entorno del sistema de reseñas.';
      error?.classList.remove('hidden');
      return;
    }

    // ¿La página pedida ya está en memoria o hay que bajar otro lote?
    const necesarios = currentPage * PER_PAGE;
    if (cargados.length < necesarios && cargados.length < total) {
      loading?.classList.remove('hidden');
      error?.classList.add('hidden');
    }

    try {
      while (cargados.length < necesarios && cargados.length < total) {
        const nuevas = await cargarLote();
        if (nuevas === 0) break;
      }
    } catch (err) {
      console.error('Error cargando testimonios:', err);
      loading?.classList.add('hidden');
      error?.classList.remove('hidden');
      return;
    }

    loading?.classList.add('hidden');
    error?.classList.add('hidden');

    const totalConocido = Number.isFinite(total) ? total : cargados.length;
    totalPages = Math.max(1, Math.ceil(totalConocido / PER_PAGE));

    const inicio = (currentPage - 1) * PER_PAGE;
    const visibles = cargados.slice(inicio, inicio + PER_PAGE);

    if (cargados.length === 0) {
      grid.innerHTML = '';
      vacio?.classList.remove('hidden');
      resumen?.classList.add('hidden');
      actualizarControles();
      return;
    }

    testimoniosVisibles = visibles;
    vacio?.classList.add('hidden');
    grid.innerHTML = visibles.map((t, i) => renderTarjeta(t, i)).join('');
    requestAnimationFrame(prepararComentarios);

    resumen?.classList.remove('hidden');
    resumen?.classList.add('flex');
    document.getElementById('testimonios-promedio').textContent = `${promedio.toFixed(1)} / 5`;
    document.getElementById('testimonios-total').textContent = `· ${totalConocido} reseña${totalConocido !== 1 ? 's' : ''}`;
    document.getElementById('testimonios-estrellas').innerHTML = renderEstrellas(Math.round(promedio));

    animarTarjetas();
    actualizarControles();
  }

  async function irAPagina(pagina) {
    const destino = Math.min(Math.max(pagina, 1), totalPages);
    if (destino === currentPage) return;
    currentPage = destino;
    await renderPagina();
  }

  document.getElementById('testimonios-prev')?.addEventListener('click', () => irAPagina(currentPage - 1));
  document.getElementById('testimonios-next')?.addEventListener('click', () => irAPagina(currentPage + 1));

  // --- Comentarios largos: elipsis (line-clamp) + modal de detalle ---
  function prepararComentarios() {
    const grid = document.getElementById('testimonios-grid');
    if (!grid) return;
    grid.querySelectorAll('.testimonial-card').forEach((card) => {
      const comentario = card.querySelector('[data-comentario]');
      const nombre = card.querySelector('[data-nombre]');
      const recortadoComentario = comentario ? comentario.scrollHeight > comentario.clientHeight + 2 : false;
      const recortadoNombre = nombre ? nombre.scrollHeight > nombre.clientHeight + 2 : false;
      const recortado = recortadoComentario || recortadoNombre;
      card.classList.toggle('cursor-pointer', recortado);
      if (recortado) card.setAttribute('data-expandible', '1');
      else card.removeAttribute('data-expandible');
      const hint = card.querySelector('[data-ver-mas]');
      if (hint) hint.classList.toggle('hidden', !recortado);
    });
  }

  function abrirDetalle(testimonio) {
    if (!detalleDialog || !testimonio) return;
    document.getElementById('detalle-nombre').textContent = testimonio.autor_nombre || '';
    document.getElementById('detalle-tipo').textContent = testimonio.titulo || 'Cliente';
    document.getElementById('detalle-fecha').textContent = testimonio.created_at ? formatearFecha(testimonio.created_at) : '';
    document.getElementById('detalle-estrellas').innerHTML = renderEstrellas(testimonio.calificacion);
    document.getElementById('detalle-comentario').textContent = testimonio.comentario || '';
    detalleDialog.showModal();
    document.body.style.overflow = 'hidden';
  }

  function cerrarDetalle() {
    if (detalleDialog?.open) detalleDialog.close();
    document.body.style.overflow = '';
  }

  document.getElementById('testimonios-grid')?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest('[data-expandible]');
    if (!card) return;
    const testimonio = testimoniosVisibles[Number(card.getAttribute('data-testimonial'))];
    abrirDetalle(testimonio);
  });

  document.getElementById('cerrar-detalle')?.addEventListener('click', cerrarDetalle);

  detalleDialog?.addEventListener('click', (event) => {
    const rect = detalleDialog.getBoundingClientRect();
    const fuera =
      event.clientX < rect.left ||
      event.clientX > rect.right ||
      event.clientY < rect.top ||
      event.clientY > rect.bottom;
    if (fuera) cerrarDetalle();
  });

  detalleDialog?.addEventListener('close', () => {
    document.body.style.overflow = '';
  });

  window.addEventListener('resize', () => requestAnimationFrame(prepararComentarios));

  animarHeader();
  renderPagina();
</script>
