---
const servicios = [
  {
    titulo: 'Contabilización de ingresos y gastos',
    detalle: 'Registro ordenado y control de las operaciones del negocio.',
    icono: '<rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>',
  },
  {
    titulo: 'Facturación',
    detalle: 'Emisión y gestión de comprobantes fiscales.',
    icono: '<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>',
  },
  {
    titulo: 'Conciliaciones bancarias',
    detalle: 'Cotejo de movimientos bancarios contra la contabilidad.',
    icono: '<line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/>',
  },
  {
    titulo: 'Declaración del 4% sobre nóminas',
    detalle: 'Cálculo, presentación y seguimiento del impuesto sobre nóminas.',
    icono: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
  {
    titulo: 'Declaración mensual del SAT',
    detalle: 'ISR, IVA, RESICO y retenciones de salarios.',
    icono: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  },
  {
    titulo: 'Declaración DIOT',
    detalle: 'Declaración informativa de operaciones con terceros.',
    icono: '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>',
  },
];
---

<section id="contabilidad" class="relative overflow-hidden bg-white py-14 dark:bg-slate-950 md:py-20">
  <div class="absolute inset-0 pointer-events-none opacity-[0.5] dark:opacity-[0.18]" style="background-image: radial-gradient(circle at 1px 1px, rgba(148, 163, 184, 0.16) 1px, transparent 0); background-size: 28px 28px;"></div>
  <div class="absolute -top-28 left-[-7rem] h-72 w-72 rounded-full bg-cyan-400/10 blur-3xl"></div>
  <div class="absolute bottom-[-7rem] right-[-6rem] h-72 w-72 rounded-full bg-slate-500/8 blur-3xl dark:bg-slate-700/10"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-cyan-400/20 bg-slate-50/70 px-4 py-2 text-xs font-semibold uppercase tracking-[0.28em] text-cyan-700 shadow-sm backdrop-blur dark:border-slate-700/70 dark:bg-slate-950/70 dark:text-cyan-200 opacity-0 translate-y-8" id="contabilidad-eyebrow">
        Área contable
      </div>

      <h2 class="section-title mt-6 opacity-0 translate-y-8" id="contabilidad-title">
        Servicios contables y fiscales
      </h2>

      <p class="section-subtitle mt-5 opacity-0 translate-y-8" id="contabilidad-subtitle">
        Complementamos la asesoría jurídica con un área contable y fiscal que mantiene tus obligaciones al día.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-5xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {servicios.map((servicio) => (
        <a href="#contacto" data-asunto="Contabilidad y Fiscal" class="contabilidad-card group flex items-start gap-4 rounded-2xl border border-slate-200/80 bg-slate-50/70 p-5 shadow-[0_12px_40px_rgba(15,23,42,0.05)] backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-cyan-300 hover:bg-cyan-50/60 dark:border-slate-800/70 dark:bg-slate-900/60 dark:hover:border-cyan-500/30 dark:hover:bg-slate-900 opacity-0 translate-y-8">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-cyan-500/10 text-cyan-500 transition-colors duration-300 group-hover:bg-cyan-500/15">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={servicio.icono} />
          </div>
          <div class="min-w-0">
            <h3 class="font-semibold leading-snug text-slate-800 dark:text-slate-100">{servicio.titulo}</h3>
            <p class="mt-1 text-sm leading-relaxed text-slate-500 dark:text-slate-400">{servicio.detalle}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-4 rounded-[2rem] border border-slate-200/80 bg-slate-50/70 p-6 shadow-[0_24px_70px_rgba(15,23,42,0.06)] backdrop-blur md:flex-row md:items-center dark:border-slate-800/60 dark:bg-slate-950/80 opacity-0 translate-y-8" id="contabilidad-cta">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-cyan-600 dark:text-cyan-200">Y entre otros</p>
        <h3 class="mt-2 font-serif text-2xl font-semibold text-slate-900 dark:text-slate-100">Ajustamos el servicio contable a las necesidades de tu negocio.</h3>
      </div>

      <a href="#contacto" class="btn-primary inline-flex items-center gap-2 rounded-full !px-6 !py-3">
        Agendar consulta
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: '#contabilidad',
      start: 'top 75%',
      toggleActions: 'play none none none',
    },
  });

  tl.to('#contabilidad-eyebrow', { opacity: 1, y: 0, duration: 0.6 })
    .to('#contabilidad-title', { opacity: 1, y: 0, duration: 0.7 }, '-=0.35')
    .to('#contabilidad-subtitle', { opacity: 1, y: 0, duration: 0.6 }, '-=0.4')
    .to('.contabilidad-card', { opacity: 1, y: 0, duration: 0.6, stagger: 0.08 }, '-=0.3')
    .to('#contabilidad-cta', { opacity: 1, y: 0, duration: 0.6 }, '-=0.3');
</script>
